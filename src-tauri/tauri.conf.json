{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ue-launcher",
  "version": "1.0.1",
  "identifier": "com.ue-launcher.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "UE Launcher",
        "width": 1000,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "Unreal Engine project launcher and toolbox",
    "shortDescription": "UE Launcher",
    "category": "DeveloperTool"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBNDhDOEE2RDYxNkRBN0UKUldSKzJoYldwc2hJdWlzQWdvTmQvMnlpSHpVdzR0WUEzTjBmQ0EzQlNwZHJ5Mms0a1hjaVgzKysK",
      "endpoints": [
        "https://github.com/Ciji-Games/UE_Launcher_CommandHelper/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}